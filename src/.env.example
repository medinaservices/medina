# Lead form → email (POST /api/lead)
# Copy to .env.local for local dev; set the same keys in Vercel →
# Project Settings → Environment Variables (Production + Preview), then redeploy.
# An environment variable does not reach an already-built deployment.

# Resend API key (https://resend.com → API Keys). Server-side only — never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where the leads land.
LEAD_TO_EMAIL=medinaservicesva@gmail.com

# Sender.
LEAD_FROM_EMAIL=Medina Services Website <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# Why these two values and not @medinaservices.us
#
# Sending as the company's own domain needs it verified in Resend, which needs an
# MX record on a `send` subdomain. The domain's DNS is on Namecheap with Private
# Email, and that panel will not add a subdomain MX without switching Mail
# Settings to "Custom MX" — which drops the records that make info@medinaservices.us
# receive mail, and offers only one row to re-enter them. Not worth the risk.
#
# So the form uses Resend's own `onboarding@resend.dev`, which sends without any
# domain verification but only to the Resend account owner's address — currently
# medinaservicesva@gmail.com. Reply-to is always the lead's own address, so
# replying from the inbox reaches them directly.
#
# To move to the company domain later: verify medinaservices.us in Resend (DKIM
# and the SPF TXT are already published; only the `send` MX is missing), then set
#   LEAD_FROM_EMAIL=Medina Services Website <leads@medinaservices.us>
#   LEAD_TO_EMAIL=info@medinaservices.us
# and redeploy. No code changes.
# ---------------------------------------------------------------------------

# Optional — second recipient (e.g. info@medinaservices.us once it can receive from Resend).
# LEAD_CC_EMAIL=

# Optional — "true" also sends a confirmation email to whoever submitted the form.
# LEAD_AUTOREPLY=false
